# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Database Configuration
PGHOST=your-postgres-host
PGDATABASE=your-database-name
PGUSER=your-database-user
PGPASSWORD=your-database-password
PGSSLMODE=require
PGPORT=5432

# JWT Configuration
JWT_SECRET=replace-with-a-strong-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Email Configuration
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

#SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Legacy compatibility for email batch size (used by external processor)
EMAIL_SCHEDULER_BATCH_SIZE=50

# External email automation scheduler config (GitHub Actions + script one-shot)
CRON_TIMEZONE=America/Bogota
EMAIL_AUTOMATION_WINDOW_MINUTES=5
EMAIL_AUTOMATION_ENABLE_PENDING=true
EMAIL_AUTOMATION_ENABLE_SESSION_REMINDERS=true
EMAIL_AUTOMATION_ENABLE_WEEKLY_MOTIVATION=true
SESSION_REMINDER_TRIGGER_HOUR=2
SESSION_REMINDER_AGE_DAYS=7
WEEKLY_MOTIVATION_TRIGGER_HOUR=9
EMAIL_AUTOMATION_FORCE_SESSION_REMINDERS=false
EMAIL_AUTOMATION_FORCE_WEEKLY_MOTIVATION=false
WEEKLY_MOTIVATION_DELAY_MS=15000
