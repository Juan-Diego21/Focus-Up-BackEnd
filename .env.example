# Server Configuration
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Database Configuration
PGHOST=your-postgres-host
PGDATABASE=your-database-name
PGUSER=your-database-user
PGPASSWORD=your-database-password
PGSSLMODE=require
PGPORT=5432

# JWT Configuration
JWT_SECRET=replace-with-a-strong-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-secret
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Email Configuration
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# In-process email scheduler (Web Service)
EMAIL_SCHEDULER_ENABLED=true
EMAIL_SCHEDULER_INTERVAL_MS=60000
EMAIL_SCHEDULER_BATCH_SIZE=50

# Weekly motivation cron config
CRON_TIMEZONE=America/Bogota
WEEKLY_MOTIVATION_DELAY_MS=15000
